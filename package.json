{
  "name": "@unilab/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Uni-Lab frontend monorepo",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter @unilab/kernel-web dev",
    "dev:desktop": "pnpm --filter @unilab/desktop dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @unilab/kernel-web build",
    "build:desktop": "pnpm --filter @unilab/desktop build",
    "card": "pnpm --filter @unilab/device-card-tooling build && node packages/device-card-tooling/dist/cli.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e:workflow": "playwright test e2e/workflow-authoring-real-os.spec.ts e2e/workflow-task-runtime-real-os.spec.ts e2e/workflow-task-runtime-resilience-real-os.spec.ts",
    "test:e2e:workflow-authoring": "playwright test e2e/workflow-authoring-real-os.spec.ts",
    "test:e2e:workflow-composite": "playwright test e2e/workflow-composite-authoring-real-os.spec.ts",
    "test:e2e:workflow-authoring-import": "playwright test e2e/workflow-authoring-import-real-os.spec.ts",
    "test:e2e:workflow-task-runtime": "playwright test e2e/workflow-task-runtime-real-os.spec.ts",
    "test:e2e:workflow-task-runtime-resilience": "playwright test e2e/workflow-task-runtime-resilience-real-os.spec.ts",
    "test:e2e:workflow-material-source": "playwright test e2e/workflow-material-source-native-cli-real-os.spec.ts",
    "test:workflow-runtime-contract": "node scripts/verify-workflow-runtime-contract.mjs",
    "test:e2e:workflow-final-gate": "pnpm test:workflow-runtime-contract && playwright test e2e/workflow-runtime-final-gate-real-os.spec.ts",
    "test:e2e:workflow-debug": "pnpm test:workflow-runtime-contract && playwright test e2e/workflow-authoring-real-os.spec.ts e2e/workflow-task-runtime-real-os.spec.ts e2e/workflow-task-runtime-resilience-real-os.spec.ts e2e/workflow-runtime-final-gate-real-os.spec.ts",
    "test:e2e:material-create": "UNILAB_E2E_MATERIAL_CREATE_FIXTURE=1 playwright test e2e/material-create.spec.ts",
    "test:e2e:materials": "UNILAB_E2E_HEADED=1 xvfb-run -a playwright test e2e/material-scene.spec.ts",
    "test:e2e:device-catalog": "playwright test e2e/device-catalog-real-os.spec.ts",
    "test:e2e:device-manual-unlock": "playwright test e2e/device-manual-unlock-real-os.spec.ts",
    "test:e2e:device-single-action": "playwright test e2e/device-single-action-real-os.spec.ts",
    "test:e2e:desktop-local-runtime": "UNILAB_E2E_ELECTRON=1 playwright test e2e/local-runtime-electron-real-edge.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "sass": "^1.93.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "patchedDependencies": {
      "@pascal-app/editor@0.9.2": "patches/@pascal-app__editor@0.9.2.patch"
    }
  }
}
