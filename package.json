{
  "name": "@unilab/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Uni-Lab frontend monorepo",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm run workbench",
    "dev:desktop": "pnpm --filter @unilab/desktop dev",
    "workbench": "pnpm --filter @unilab/workbench-theia build && pnpm --filter @unilab/workbench build && pnpm --filter @unilab/workbench start",
    "workbench:desktop": "pnpm --filter @unilab/workbench desktop",
    "workbench:desktop:development": "pnpm --filter @unilab/workbench desktop:development",
    "workbench:desktop:welcome:development": "pnpm --filter @unilab/workbench desktop:welcome:development",
    "workbench:desktop-remote": "pnpm --filter @unilab/workbench-theia build && pnpm --filter @unilab/workbench build && pnpm --filter @unilab/workbench start:desktop-remote",
    "workbench:remote": "pnpm --filter @unilab/workbench-theia build && pnpm --filter @unilab/workbench build && pnpm --filter @unilab/workbench start:remote",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @unilab/kernel-web build",
    "check:web:bundle-size": "pnpm --filter @unilab/kernel-web check:bundle-size",
    "test:web:deployment": "pnpm --filter @unilab/kernel-web test:deployment",
    "build:desktop": "pnpm --filter @unilab/desktop build",
    "quality:frontend": "node scripts/check-frontend-quality.mjs",
    "quality:styles": "node scripts/check-style-architecture.mjs",
    "card": "pnpm --filter @unilab/device-card-tooling build && node packages/device-card-tooling/dist/cli.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e:workflow": "playwright test e2e/workflow-start-flow-real-os.spec.ts e2e/workflow-authoring-real-os.spec.ts e2e/workflow-authoring-ui-real-os.spec.ts e2e/workflow-task-runtime-real-os.spec.ts e2e/workflow-task-runtime-resilience-real-os.spec.ts",
    "test:e2e:workflow-start-flow": "playwright test e2e/workflow-start-flow-real-os.spec.ts",
    "test:e2e:workflow-authoring": "playwright test e2e/workflow-authoring-real-os.spec.ts e2e/workflow-authoring-ui-real-os.spec.ts",
    "test:e2e:workflow-composite": "node scripts/run-f06-composite-e2e.mjs",
    "test:e2e:workflow-task-input-f07": "node scripts/run-f07-task-input-e2e.mjs",
    "test:e2e:workflow-single-node-f08": "node scripts/run-f08-single-node-e2e.mjs",
    "test:e2e:workflow-sse-reconnect-f09": "node scripts/run-f09-sse-reconnect-e2e.mjs",
    "test:e2e:workflow-authoring-import": "playwright test e2e/workflow-authoring-import-real-os.spec.ts e2e/workflow-import-mismatch-real-os.spec.ts",
    "test:e2e:workflow-task-runtime": "playwright test e2e/workflow-task-runtime-real-os.spec.ts",
    "test:e2e:workflow-task-runtime-resilience": "playwright test e2e/workflow-task-runtime-resilience-real-os.spec.ts",
    "test:e2e:workflow-material-source": "playwright test e2e/workflow-material-source-native-cli-real-os.spec.ts",
    "test:e2e:workflow-material-source-f05": "playwright test e2e/workflow-material-source-f05-real-os.spec.ts",
    "test:e2e:workflow-material-flow": "playwright test e2e/workflow-material-flow-projection-real-os.spec.ts",
    "test:workflow-runtime-contract": "node scripts/verify-workflow-runtime-contract.mjs",
    "test:e2e:workflow-final-gate": "pnpm test:workflow-runtime-contract && playwright test e2e/workflow-runtime-final-gate-real-os.spec.ts",
    "test:e2e:workflow-debug": "pnpm test:workflow-runtime-contract && playwright test e2e/workflow-authoring-real-os.spec.ts e2e/workflow-authoring-ui-real-os.spec.ts e2e/workflow-task-runtime-real-os.spec.ts e2e/workflow-task-runtime-resilience-real-os.spec.ts e2e/workflow-runtime-final-gate-real-os.spec.ts",
    "test:e2e:material-create": "node scripts/run-playwright-e2e.mjs --env UNILAB_E2E_MATERIAL_CREATE_FIXTURE=1 -- e2e/material-create.spec.ts",
    "test:e2e:material-oblique": "node scripts/run-playwright-e2e.mjs --env UNILAB_E2E_MATERIAL_OBLIQUE_FIXTURE=1 -- e2e/material-oblique-rotation.spec.ts",
    "test:e2e:materials": "node scripts/run-playwright-e2e.mjs --env UNILAB_E2E_HEADED=1 --virtual-display -- e2e/material-scene.spec.ts",
    "test:e2e:device-catalog": "playwright test e2e/device-catalog-real-os.spec.ts",
    "test:e2e:device-manual-unlock": "playwright test e2e/device-manual-unlock-real-os.spec.ts",
    "test:e2e:device-single-action": "playwright test e2e/device-single-action-real-os.spec.ts",
    "test:e2e:desktop-local-runtime": "node scripts/run-playwright-e2e.mjs --env UNILAB_E2E_ELECTRON=1 -- e2e/local-runtime-electron-real-edge.spec.ts",
    "test:e2e:desktop-workspace-reselection": "node apps/desktop/scripts/run-workbench-workspace-reselection-e2e.mjs",
    "test:e2e:workbench": "playwright test e2e/unilab-workbench.spec.ts e2e/workbench-runtime-log-drawer.spec.ts",
    "test:e2e:new-unresolved": "playwright test --config e2e/new-unresolved.playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "sass": "^1.93.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "@vscode/windows-ca-certs@0.3.4": true,
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/windows-ca-certs",
      "electron",
      "esbuild",
      "drivelist",
      "node-pty"
    ],
    "patchedDependencies": {
      "@pascal-app/editor@0.9.2": "patches/@pascal-app__editor@0.9.2.patch"
    }
  }
}
