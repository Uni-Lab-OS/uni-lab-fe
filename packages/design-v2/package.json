{
  "name": "@unilab/design-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:source": "node scripts/generate-source-tokens.mjs",
    "build:icons": "node scripts/build-icon-assets.mjs",
    "icons:sync": "node scripts/sync-icons.mjs",
    "validate:icons": "node scripts/validate-icons.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./theme": "./src/runtime/theme.ts",
    "./core.css": "./src/core.css",
    "./themes/default.css": "./src/themes/default.css",
    "./tokens/source": "./src/tokens/source.ts",
    "./tokens/source.colors.css": "./src/tokens/source.colors.css",
    "./tokens/source.foundation.css": "./src/tokens/source.foundation.css",
    "./tokens/source.theme.css": "./src/tokens/source.theme.css",
    "./tokens/source.responsive.css": "./src/tokens/source.responsive.css",
    "./tokens/source.icons.css": "./src/tokens/source.icons.css",
    "./adapters/tailwind.css": "./src/adapters/tailwind.css",
    "./adapters/antd.css": "./src/adapters/antd.css",
    "./empty.css": "./src/empty.css",
    "./adapters/antd-theme": "./src/adapters/antdTheme.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/styles.css": "./src/icons/styles.css",
    "./icons/manifest": "./src/icons/generated/manifest.ts",
    "./icons/assets/*": "./src/icons/assets/*",
    "./icons/static/*": "./src/icons/static/*.ts"
  }
}
