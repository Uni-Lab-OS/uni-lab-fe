{
  "name": "@unilab/device-card-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.mjs --external:esbuild --external:@vue/compiler-sfc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@unilab/device-card-sdk": "workspace:*",
    "@unilab/device-card-ui": "workspace:*",
    "@vue/compiler-sfc": "^3.5.12",
    "esbuild": "0.21.5",
    "fflate": "^0.8.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  }
}
