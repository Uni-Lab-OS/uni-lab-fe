{
  "name": "@unilab/workbench",
  "version": "0.1.1",
  "private": true,
  "author": "UniLab",
  "description": "UniLab 调试工作台（UniLab Workbench）desktop and browser application",
  "main": "./desktop/main.cjs",
  "dependencies": {
    "@theia/ai-core": "1.74.1",
    "@theia/ai-mcp": "1.74.1",
    "@theia/bulk-edit": "1.74.1",
    "@theia/callhierarchy": "1.74.1",
    "@theia/console": "1.74.1",
    "@theia/core": "1.74.1",
    "@theia/debug": "1.74.1",
    "@theia/editor": "1.74.1",
    "@theia/editor-preview": "1.74.1",
    "@theia/file-search": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/markers": "1.74.1",
    "@theia/messages": "1.74.1",
    "@theia/monaco": "1.74.1",
    "@theia/monaco-editor-core": "1.108.201",
    "@theia/navigator": "1.74.1",
    "@theia/notebook": "1.74.1",
    "@theia/outline-view": "1.74.1",
    "@theia/output": "1.74.1",
    "@theia/plugin-ext": "1.74.1",
    "@theia/plugin-ext-vscode": "1.74.1",
    "@theia/preferences": "1.74.1",
    "@theia/process": "1.74.1",
    "@theia/scm": "1.74.1",
    "@theia/scm-extra": "1.74.1",
    "@theia/search-in-workspace": "1.74.1",
    "@theia/task": "1.74.1",
    "@theia/terminal": "1.74.1",
    "@theia/test": "1.74.1",
    "@theia/timeline": "1.74.1",
    "@theia/typehierarchy": "1.74.1",
    "@theia/userstorage": "1.74.1",
    "@theia/variable-resolver": "1.74.1",
    "@theia/vsx-registry": "1.74.1",
    "@theia/workspace": "1.74.1",
    "@unilab/workbench-theia": "workspace:*",
    "node-pty": "1.2.0-beta.12",
    "reflect-metadata": "0.2.2"
  },
  "optionalDependencies": {
    "@parcel/watcher-darwin-arm64": "2.6.0",
    "@parcel/watcher-darwin-x64": "2.6.0",
    "@parcel/watcher-linux-arm64-glibc": "2.6.0",
    "@parcel/watcher-linux-x64-glibc": "2.6.0",
    "@parcel/watcher-win32-arm64": "2.6.0",
    "@parcel/watcher-win32-x64": "2.6.0",
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@vscode/ripgrep-darwin-x64": "1.18.0",
    "@vscode/ripgrep-linux-arm64": "1.18.0",
    "@vscode/ripgrep-linux-x64": "1.18.0",
    "@vscode/ripgrep-win32-arm64": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "@vscode/windows-ca-certs": "0.3.4",
    "trash": "7.2.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@theia/bundle-plugin": "1.74.1",
    "@theia/cli": "1.74.1",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "esbuild": "0.28.2",
    "esbuild-plugin-copy": "2.1.1",
    "esbuild-plugins-node-modules-polyfill": "1.8.3",
    "esbuild-sass-plugin": "3.7.0",
    "resolve-package-path": "4.0.3",
    "sass-embedded": "1.97.3",
    "yargs": "17.7.3"
  },
  "scripts": {
    "build": "pnpm --filter @unilab/workbench-theia build && pnpm --filter @unilab/pascal-host build:styles && theia download:plugins && node scripts/run-theia-build.mjs --mode development",
    "build:production": "pnpm --filter @unilab/workbench-theia build && pnpm --filter @unilab/pascal-host build:styles && theia download:plugins && node scripts/run-theia-build.mjs --mode production && node scripts/prune-production-output.mjs",
    "build:desktop": "pnpm --filter @unilab/desktop build:workbench-shell && pnpm build:production && pnpm build:desktop-launcher",
    "build:desktop:development": "pnpm --filter @unilab/desktop build:workbench-shell && pnpm build && pnpm build:desktop-launcher",
    "build:desktop:production": "pnpm build:desktop",
    "build:desktop-launcher": "node scripts/build-desktop-launcher.mjs",
    "desktop": "pnpm build:desktop && node scripts/dev-desktop.mjs --production-build",
    "desktop:development": "pnpm build:desktop:development && node scripts/dev-desktop.mjs",
    "desktop:once": "pnpm build:desktop && pnpm start:desktop",
    "desktop:welcome": "pnpm build:desktop && pnpm start:desktop-welcome",
    "start": "node scripts/start-workbench.mjs",
    "start:desktop": "node scripts/start-workbench.mjs --desktop",
    "start:desktop-welcome": "electron .",
    "start:desktop-remote": "node scripts/start-workbench.mjs --desktop --remote",
    "start:remote": "node scripts/start-workbench.mjs --remote",
    "start:theia-only": "theia start \"${THEIA_WORKSPACE:-../..}\" --hostname 127.0.0.1 --port ${THEIA_PORT:-3100} --plugins=local-dir:plugins",
    "start:headless-renderer": "node scripts/headless-renderer.mjs",
    "package:mac": "pnpm build:desktop:production && node scripts/package-macos.mjs --signed",
    "package:mac:developer-id": "pnpm build:desktop:production && node scripts/package-macos.mjs --developer-id",
    "package:mac:adhoc": "pnpm build:desktop:production && node scripts/package-macos.mjs --adhoc",
    "package:mac:unsigned": "pnpm build:desktop:production && node scripts/package-macos.mjs --unsigned",
    "package:linux": "pnpm build:desktop:production && node scripts/package-linux.mjs",
    "package:win": "pnpm build:desktop:production && node scripts/package-windows.mjs",
    "test": "node --test scripts/*.test.mjs",
    "watch": "node scripts/run-theia-build.mjs --watch --mode development"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "UniLab 调试工作台",
        "defaultLocale": "zh-cn"
      }
    }
  },
  "theiaPlugins": {
    "MS-CEINTL.vscode-language-pack-zh-hans": "https://open-vsx.org/api/MS-CEINTL/vscode-language-pack-zh-hans/1.108.0/file/MS-CEINTL.vscode-language-pack-zh-hans-1.108.0.vsix",
    "ms-pyright.pyright": "https://open-vsx.org/api/ms-pyright/pyright/1.1.402/file/ms-pyright.pyright-1.1.402.vsix",
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix",
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix"
  }
}
